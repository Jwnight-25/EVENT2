# SQLite local mode is the default. Set DATABASE_URL for PostgreSQL mode.
# DATABASE_URL=postgresql+psycopg://event2:YOUR_PASSWORD@127.0.0.1:5432/event2
POSTGRES_PASSWORD=replace-with-your-local-password
