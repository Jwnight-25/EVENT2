# SQLite local mode is the default. Set DATABASE_URL for PostgreSQL mode.
# DATABASE_URL=postgresql+psycopg://event2:YOUR_PASSWORD@127.0.0.1:5432/event2
POSTGRES_PASSWORD=replace-with-your-local-password
# Optional absolute storage location:
# DATA_DIR=/absolute/path/to/storage
# Optional complete backup location (outside DATA_DIR):
# BACKUP_DIR=/absolute/path/to/backups
# Optional user-configured research service; see docs/implementation.md contract.
# AI_ANALYSIS_URL=https://your-service.example/analyze
# AI_API_KEY=
# Or configure the new AI provider in the local prediction-page settings.
# Environment fallback (page-saved settings take priority):
# AI_PROVIDER=openai
# AI_MODEL=your-account-supported-model
# AI_WEB_SEARCH=true
# AI_API_KEY=
# Compatible chat only, without built-in web search:
# AI_PROVIDER=compatible
# AI_BASE_URL=https://your-service.example/v1
